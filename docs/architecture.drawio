<mxfile host="app.diagrams.net"><diagram id="page1" name="1 System architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Elder Monitor: system architecture" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Indoor video file&lt;/b&gt;&lt;br&gt;(webcam through the API)&lt;br&gt;+ scene config (bed polygon)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Frame sampler&lt;/b&gt; (video.py)&lt;br&gt;5 fps grid, decoded timestamps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="300" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;YOLO11n-pose&lt;/b&gt;&lt;br&gt;person boxes + 17 body keypoints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="300" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;ByteTrack&lt;/b&gt;&lt;br&gt;track IDs across frames" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="300" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Target selector&lt;/b&gt; (vision.py)&lt;br&gt;which person is the resident?&lt;br&gt;people seen beside it are never adopted" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="300" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Features&lt;/b&gt; (features.py)&lt;br&gt;body axis, knee angle, thigh / shin,&lt;br&gt;bed-polygon distance, speed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="300" height="70" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Frame proposals&lt;/b&gt; (temporal.propose)&lt;br&gt;posture rules + hysteresis per sample" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="590" width="300" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Context agent&lt;/b&gt; (agent.py)&lt;br&gt;reviews ambiguous spans, verifies exit candidates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="690" width="300" height="60" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Temporal engine&lt;/b&gt; (temporal.py)&lt;br&gt;5-sample majority filter, dwell 1-2 s,&lt;br&gt;boundaries backdated to where a state began" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="790" width="300" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Activity timeline&lt;/b&gt; + &lt;b&gt;bed-status timeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="900" width="300" height="50" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Bed-event state machine&lt;/b&gt; (events.py)&lt;br&gt;BED_EXIT / RETURN_TO_BED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="990" width="300" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Alert policy&lt;/b&gt; (policy.py)&lt;br&gt;NORMAL / MONITOR / ALERT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="1090" width="300" height="60" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;timeline.csv, summary.json, events.json,&lt;br&gt;decisions.csv, agent_trace.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="1190" width="300" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Agent tools&lt;/b&gt;&lt;br&gt;look_back, look_ahead&lt;br&gt;inspect_bed_relation&lt;br&gt;inspect_target_crop &amp;rarr; &lt;b&gt;Qwen2.5-VL-3B&lt;/b&gt;&lt;br&gt;abstain" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="665" width="240" height="110" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Labels&lt;/b&gt; (examples/annotations/*.json)&lt;br&gt;AI-drafted, not yet human-reviewed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="1095" width="240" height="55" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Evaluation&lt;/b&gt; (evaluation.py)&lt;br&gt;accuracy, confusion, event precision /&lt;br&gt;recall, duration error" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="1190" width="240" height="70" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelB